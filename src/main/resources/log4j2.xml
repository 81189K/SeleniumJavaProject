<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <!-- Define the appenders -->
    <Appenders>

        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </Console>

        <!-- General File Appender -->
        <File name="FileLogger"
              fileName="logs/info.log"
              append="true">

            <Filters>
                <!-- Exclude ERROR and FATAL logs -->
                <ThresholdFilter level="ERROR"
                                 onMatch="DENY"
                                 onMismatch="ACCEPT" />
            </Filters>

            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </File>

        <!-- Error File Appender -->
        <File name="ErrorFileLogger"
              fileName="logs/error.log"
              append="true">

            <Filters>
                <!-- Include only ERROR and FATAL logs -->
                <ThresholdFilter level="ERROR"
                                 onMatch="ACCEPT"
                                 onMismatch="DENY" />
            </Filters>

            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </File>

    </Appenders>

    <!-- Define the loggers -->
    <Loggers>

        <!-- Root Logger -->
        <Root level="info">
            <AppenderRef ref="Console" />
        </Root>

        <!-- Logger for com.hp package -->
        <Logger name="com.hp"
                level="trace"
                additivity="false">

            <AppenderRef ref="Console" />
            <AppenderRef ref="FileLogger" />
            <AppenderRef ref="ErrorFileLogger" />

        </Logger>

    </Loggers>

</Configuration>